# Copy to .env.local and fill in (from cloud.livekit.io -> Settings -> API keys,
# or run: lk app env -w)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional model overrides (LiveKit Inference model IDs)
# STT_MODEL=deepgram/nova-3:multi
# LLM_MODEL=openai/gpt-4.1-mini
# TTS_MODEL=cartesia/sonic-3
# Arabic/Darja note: Deepgram's ":multi" code-switching may not cover Arabic.
# Arabic-capable alternatives on LiveKit Inference include:
# STT_MODEL=openai/gpt-live-transcribe:multi
# STT_MODEL=deepgram/nova-3:ar
