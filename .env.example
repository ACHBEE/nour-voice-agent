# Copy to .env.local and fill in (from cloud.livekit.io -> Settings -> API keys,
# or run: lk app env -w)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional model overrides (LiveKit Inference model IDs)
# STT_MODEL=openai/gpt-live-transcribe:ar   (default, see evals/stt/results.md)
# LLM_MODEL=openai/gpt-4.1-mini
# TTS_MODEL=cartesia/sonic-3
# Compare STT models on your own voice: python evals/stt/record.py, then evals/stt/benchmark.py

# Postgres + pgvector (docker compose). Local dev defaults; not a secret.
DATABASE_URL=postgresql://nour:nour_dev@localhost:5433/nour

# RAG service (defaults shown)
# RAG_GRPC_ADDR=localhost:50051
# EMBED_MODEL=intfloat/multilingual-e5-small

# Agent dispatch: named (explicit dispatch) by default; empty = join every new room automatically
# AGENT_NAME=nour
# Router model (evals: gpt-4.1-nano is faster but less accurate, see DESIGN.md)
# ROUTER_MODEL=openai/gpt-4.1-mini
# Say a filler phrase if no reply text after this many ms
# FILLER_AFTER_MS=1200
